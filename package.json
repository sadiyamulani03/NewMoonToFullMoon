{
  "name": "midnighttrace",
  "description": "MidnightTrace - Private Blockchain Forensics - full-stack dApp on the Midnight Network (Levels 1-4)",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"node server/index.mjs\" \"vite\"",
    "dev:api": "node server/index.mjs",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "build:web": "vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run && npm run build && node tests/smoke.mjs && node tests/api-smoke.mjs",
    "test:contract": "vitest run",
    "test:frontend": "npm run build && node tests/smoke.mjs && node tests/api-smoke.mjs",
    "compile": "compact compile contracts/hello-world.compact contracts/managed/hello-world && compact compile contracts/counter.compact contracts/managed/counter && compact compile contracts/midnighttrace.compact contracts/managed/midnighttrace",
    "compile:counter": "compact compile contracts/counter.compact contracts/managed/counter",
    "compile:midnighttrace": "compact compile contracts/midnighttrace.compact contracts/managed/midnighttrace",
    "deploy:counter": "node ./node_modules/tsx/dist/cli.mjs scripts/deploy.ts --contract counter",
    "deploy:midnighttrace": "node ./node_modules/tsx/dist/cli.mjs scripts/deploy.ts --contract midnighttrace",
    "setup": "node ./node_modules/tsx/dist/cli.mjs scripts/setup.ts",
    "deploy": "node ./node_modules/tsx/dist/cli.mjs scripts/deploy.ts",
    "cli": "node ./node_modules/tsx/dist/cli.mjs scripts/cli.ts",
    "demo:counter": "node ./node_modules/tsx/dist/cli.mjs scripts/counter-demo.ts",
    "check-balance": "node ./node_modules/tsx/dist/cli.mjs scripts/check-balance.ts",
    "network": "node ./node_modules/tsx/dist/cli.mjs scripts/network.ts",
    "proof-server:start": "docker compose up -d",
    "proof-server:stop": "docker compose down",
    "clean": "rm -rf contracts/managed .midnight-state.json .midnight-wallet-state",
    "test:e2e": "node ./node_modules/tsx/dist/cli.mjs scripts/e2e-check.ts"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/dapp-connector-api": "4.0.1",
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/midnight-js": "4.1.1",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.0",
    "events": "^3.3.0",
    "express": "^5.2.1",
    "process": "^0.11.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.2",
    "rxjs": "^7.8.2",
    "stream-browserify": "^3.0.0",
    "util": "^0.12.5",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.4",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vite-plugin-static-copy": "^3.1.4",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "midnight",
    "blockchain",
    "zero-knowledge",
    "privacy"
  ]
}
