# Preprod contract address deployed in Level 1 (MANDATORY).
VITE_CONTRACT_ADDRESS=REPLACE_WITH_YOUR_PREPROD_CONTRACT_ADDRESS

# Level 4 midnighttrace contract address (paste after `npm run deploy:midnighttrace`).
# VITE_MIDNIGHTTRACE_CONTRACT_ADDRESS=REPLACE_WITH_YOUR_MIDNIGHTTRACE_ADDRESS

# Level 4 owner secret printed by the deploy script (64 hex chars). Your wallet
# uses it as its member secret so it can act as the case owner.
# VITE_MIDNIGHTTRACE_OWNER_SECRET=REPLACE_WITH_SIXTYFOUR_HEX_OWNER_SECRET

# Midnight network the Lace wallet must be switched to.
VITE_NETWORK_ID=preprod

# X profile — overridden instantly if handle is flagged/suspended (fixes “invalid x profile link”).
# VITE_X_HANDLE=Midnight__Trace
# VITE_X_PROFILE_URL=https://x.com/Midnight__Trace
# VITE_X_PROFILE_STATUS=appeal  # live | appeal — controls badge + disclaimer in UI (Landing/About/footer)

# Proof-server URI — local dev only (http://localhost:6300). For production IAM/1AM
# you must host your own prover (midnightntwrk/proof-server:8.1.0 behind HTTPS)
# and set it here, e.g.:
# VITE_PROOF_SERVER_URI=https://prover.midnighttrace.yourdomain.com
# For local dev: docker compose up -d --wait proof-server, then set this:
VITE_PROOF_SERVER_URI=http://localhost:6300
# The app is environment-aware: on localhost it may use http://localhost:6300 as a
# fallback for 1AM (which delegates proving off-device). On Vercel/production
# (hostname not localhost) the app never tries localhost — it uses Lace in-wallet
# proving or your hosted https:// prover. Setting http://localhost:6300 on Vercel
# would break production because localhost is the user's machine, not the server.

# --- Vercel Blob persistence (production) ---
# Link a Vercel Blob store to the project — Vercel auto-injects BLOB_READ_WRITE_TOKEN.
# When present, case metadata is stored durably at MIDNIGHTTRACE_BLOB_KEY.
# Without it, cases live in /tmp (ephemeral, reseeds on cold start) and
# on-chain proofs remain verifiable via /audit.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx  # auto-injected — do not set manually locally
# MIDNIGHTTRACE_BLOB_KEY=midnighttrace/cases.json
# MIDNIGHTTRACE_DATA_FILE=/tmp/midnighttrace-cases.json  # fallback file path